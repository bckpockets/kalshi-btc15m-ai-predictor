# Public GET-only configuration. No API keys. Copy to .env if you want overrides.
# Defaults in the code match these values, so an empty environment is enough.

# Kalshi public REST root.
KALSHI_BASE=https://external-api.kalshi.com/trade-api/v2

# SQLite file for observations, forecasts, and the virtual account.
# STARTING_BANKROLL applies only when this file's account row is first created.
DATABASE_PATH=runtime.sqlite
STARTING_BANKROLL=1000

# Optional trusted model. If the file is missing, the statistical baseline is used.
# Do not point this at an untrusted pickle. See docs/IMPROVEMENT_PLAN.md.
MODEL_PATH=artifacts/model.joblib

# Collector idle delay between cycles, in seconds.
POLL_SECONDS=3

# Drop forecasts when a tick or snapshot is older than this many seconds.
MAX_DATA_AGE=10

# Assumed Coinbase-vs-BRTI basis standard deviation, in dollars.
# This is not estimated from Coinbase. Coinbase is a proxy, not the settlement index.
BASIS_SIGMA_USD=25

LOG_LEVEL=INFO

# Full open-market list discovery interval, in seconds.
# The current ticker is still refreshed every cycle.
MARKET_DISCOVERY_SECONDS=60

# Coinbase 1-minute candles, book imbalance, and 24h stats interval, in seconds.
CANDLE_SECONDS=60

# Kalshi trades are display-only. Fetch them every N collector cycles.
# Order books are fetched on a cycle only when paper entries or the edge panel can use them.
TRADES_EVERY_CYCLES=5
